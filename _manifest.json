{
  "manifest_version": 2,
  "version": "1.8.4",
  "name": "麦麦智能戳一戳调侃互动",
  "description": "一个让麦麦在 QQ 戳一戳里尽量像真人一样反应的拟人化交互插件。",
  "author": {
    "name": "Wenaixi",
    "url": "https://github.com/Wenaixi/mai-smart-poke-reaction"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/TAIY2020/smart_poke_plugin",
    "homepage": "https://github.com/TAIY2020/smart_poke_plugin",
    "documentation": "https://github.com/TAIY2020/smart_poke_plugin",
    "issues": "https://github.com/TAIY2020/smart_poke_plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.emoji",
    "api.call",
    "emoji.get_random",
    "emoji.get_by_description",
    "emoji.get_emotions",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.open_session",
    "message.get_recent",
    "message.build_readable",
    "maisaka.context.append",
    "llm.generate",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "game",
  "display": {
    "icon": {
      "type": "local",
      "value": "./assets/icon.webp"
    }
  },
  "id": "wenaixi.mai_smart_poke_reaction"
}